# Pubbliche: finiscono nel browser, ed è previsto che sia così.
NEXT_PUBLIC_SUPABASE_URL=https://rsgyxbqzsxahsbdfgtbm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SEGRETA: solo lato server. Mai con il prefisso NEXT_PUBLIC_, mai in git.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe. La chiave secret apre le Checkout Session; lo signing secret serve solo
# a firmare un corpo di prova in locale — in produzione la firma la verifica
# Postgres leggendo la stessa parola da Supabase Vault (stripe_webhook_secret).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# La parola segreta dei webhook Cal.com, stessa storia: serve in locale per
# firmare le fixture, e sta in Vault sotto calcom_webhook_secret.
CALCOM_WEBHOOK_SECRET=...

# n8n. Solo le due che servono ai comandi scritti in `n8n/LEGGIMI.md`: le altre
# credenziali dell'istanza (password, chiave di cifratura) non le usa nessuno
# script del repo e vivono solo nel password manager — vedi `ACCESSI.md`.
N8N_PUBLIC_URL=https://<istanza>.up.railway.app
N8N_API_KEY=...
